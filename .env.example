# ---------------------------------------------------------------------------
# Clinic Income Portal - environment configuration
# Copy this file to `.env` at the repository root and adjust the values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (API).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://clinic_app:clinic_app_password@localhost:5432/clinic_income?schema=public"

# Separate database used by the automated test suite.
# WARNING: the test suite TRUNCATES this database. Never point it at real data.
TEST_DATABASE_URL="postgresql://clinic_app:clinic_app_password@localhost:5432/clinic_income_test?schema=public"

# API server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN="http://localhost:5173"

# Currency used for display formatting throughout the UI.
CURRENCY_CODE=EGP

# Base URL the web app uses to reach the API.
# Leave EMPTY in development: the Vite dev server proxies /api to the API, keeping every
# request same-origin so the app also works when opened from a phone on the same network.
# Set this only if the API is genuinely hosted on a different origin.
VITE_API_BASE_URL=
