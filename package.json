{
  "name": "clinic-income-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first portal for managing and analysing monthly income of medical clinics",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @clinic/api",
    "dev:web": "npm run dev -w @clinic/web",
    "build": "npm run build -w @clinic/shared && npm run build -w @clinic/api && npm run build -w @clinic/web",
    "test": "npm run test -w @clinic/api",
    "db:migrate": "npm run db:migrate -w @clinic/api",
    "db:seed": "npm run db:seed -w @clinic/api",
    "db:reset": "npm run db:reset -w @clinic/api",
    "db:studio": "npm run db:studio -w @clinic/api",
    "setup": "npm install && npm run build -w @clinic/shared && npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "@vercel/node": "^5.1.13",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
